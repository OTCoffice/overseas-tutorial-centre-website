{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/en/",
      "destination": "https://translate.google.com/translate?sl=auto&tl=en&u=https%3A%2F%2Foverseasuk.com%2F",
      "permanent": false
    },
    {
      "source": "/zh/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/countries/canada/finance/",
      "destination": "/countries/canada/costs/",
      "permanent": true
    },
    {
      "source": "/countries/canada/living/",
      "destination": "/countries/canada/costs/",
      "permanent": true
    },
    {
      "source": "/countries/canada/immigration/",
      "destination": "/countries/canada/pgwp/",
      "permanent": true
    },
    {
      "source": "/zh/course-selection-guide/",
      "destination": "/zh/course-selection-alliance/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "otc.overseasuk.com"
        }
      ],
      "destination": "https://overseasuk.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.otc.overseasuk.com"
        }
      ],
      "destination": "https://overseasuk.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.overseasuk.com"
        }
      ],
      "destination": "https://overseasuk.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
